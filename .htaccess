# Nordpflege24 on netcup (Apache)

# Always https, always without www
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nordpflege24.de%{REQUEST_URI} [L,R=301]

# Internal files are not part of the website
<FilesMatch "^(PROJEKT\.md|README\.md|CNAME|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.git

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8
